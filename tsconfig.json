{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "jest",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "src/types/**/*./d.ts"
, "src/__tests__/Skills.test.jsx", "src/__tests__/Projects.test.jsx", "src/__tests__/Navbar.test.jsx", "src/__tests__/Hero.test.jsx", "src/__tests__/Footer.test.jsx", "src/__tests__/Contact.test.jsx", "babel.config.js", "jest.config.js"  ],
  "exclude": [
    "node_modules"
  ]
}
